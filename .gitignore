# ---------------------------------------------------------------------------
# BACTolomew .gitignore
# Large data, prebuilt tool environments and pipeline outputs are NOT tracked.
# ---------------------------------------------------------------------------

# Conda tool environments (~24G, machine-specific; tools run via Docker at runtime)
/envs/

# Reference databases (made by first-time setup: catalogs, cgMLST schemes, user databases)
/DB/

# Tool databases first-time setup downloads (full Bakta about 76G, CheckM2) and DbDownload's default
/bakta_db/
/bakta_db_*/
/checkm2_db/
/tool_dbs/
/databases/

# Tools image as an Apptainer/Singularity file (setup's default place) and saved image archives
*.sif
*.tar
*.tar.gz
*.tar.xz
*.tar.zst
*.tar.bz2
*.tgz
*.zip
*.7z

# Pipeline run outputs (~25G)
/runs/

# Caches
/cache/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Python virtual environments
.venv/
.venv*/
venv/
.env

# Generated, machine-specific config (written by first-time setup)
/bactolomew_config.json

# Map backend experiment outputs (source kept, rendered artifacts ignored)
/misc/map_tests/out/

# Per-run UI cache, logs, scratch work and backups
ui_cache.json
*.log
nohup.out
/scratch/
*.partial/
*.bak
*.orig

# Personal editor settings and local agent settings (machine-specific paths)
.idea/
.vscode/
*.code-workspace
.agents/
.claude/settings.local.json

# Editor / tooling / OS junk
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.codex

# Agent notes and tooling (kept private)
.claude/
CLAUDE.md

# Manuscript plotting scripts (R), kept private
src/scripts/*.R
